{
  "name": "noveltea",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:tauri": "NOVELTEA_TAURI=1 vite",
    "build": "npm run typecheck && vite build",
    "build:tauri": "NOVELTEA_TAURI=1 npm run build",
    "tauri": "tauri",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint . --max-warnings 0",
    "licenses": "license-checker --production --onlyAllow \"MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;0BSD;Unlicense;OFL-1.1\" --excludePackages \"noveltea@0.1.0\" --summary",
    "client-db:generate": "npm run generate -w @noveltea/client-db",
    "test:e2e": "playwright test",
    "check:submodule": "node scripts/check-submodule.mjs",
    "predev": "npm run check:submodule",
    "prebuild": "npm run check:submodule && node tooling/ensure-thesaurus.mjs",
    "pretest": "npm run check:submodule && node tooling/ensure-thesaurus.mjs",
    "screenshots": "npm run build && node tooling/screenshots.mjs",
    "test:e2e:webkit": "NOVELTEA_WEBKIT=1 playwright test --project=webkit --project=mobile-safari",
    "thesaurus": "node tooling/build-thesaurus.mjs"
  },
  "dependencies": {
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/merriweather": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "@tiptap/extension-typography": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "license-checker": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.3",
    "vitest": "^3.2.7",
    "wordnet-db": "^3.1.14"
  },
  "workspaces": [
    "vendor/noveltea-server/packages/client-db",
    "vendor/noveltea-server/packages/compile"
  ]
}
