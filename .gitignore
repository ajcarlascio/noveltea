# Node — note: this ignores bundler output. Build *tooling* lives in tooling/,
# because a source file under build/ would be silently untracked.
node_modules/
dist/
dist-ssr/
build/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/

# Vite / bundler caches
.vite/
.cache/

# Test and coverage output
coverage/
playwright-report/
test-results/
.nyc_output/

# Tauri — the Rust build tree, not the config
src-tauri/target/
src-tauri/gen/
# Signing material must never be committed, whatever this repo's visibility becomes.
*.keystore
*.jks
*.p12
*.mobileprovision
*.p8
*.cer

# Local config and secrets
.env
.env.*
!.env.example
*.local
*.pem
*.key

# Local SQLite replicas — an author's manuscripts, never source
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm

# Compiled manuscripts produced while testing export
*.epub
*.docx
*.odt
*.rtf
*.pdf

# Coding-agent instructions — local only, deliberately.
#
# CLAUDE.md, AGENTS.md and .claude/ are how *this machine* drives an agent over the
# repository. They are not product documentation and not a contributor guide, and a
# published repository carrying one vendor's prompt files invites the next contributor
# to write a second set for their own tool. Everything a human or an external auditor
# needs is in README.md and docs/.
#
# Untracked with `git rm --cached`, so the files survive on disk and only leave the
# remote. Note that they remain in the repository's *history*; this stops them going
# forward, it does not rewrite what is already published.
CLAUDE.md
AGENTS.md
GEMINI.md
.claude/
.cursor/
.cursorrules
.aider*
.github/copilot-instructions.md

# Editors / OS
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Private notes — mirrors the server repo's convention
*.local.md
*.private.md

# Review screenshots — regenerate with `npm run screenshots`, never commit the PNGs.
screenshots/

# Generated from wordnet-db by tooling/build-thesaurus.mjs — 3.7MB, rebuilt on demand.
# The licence beside it is copied from the package and is not generated by us.
public/thesaurus/wordnet.json
