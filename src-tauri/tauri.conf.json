{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NovelTea",
  "version": "0.1.0",
  "identifier": "io.github.ajcarlascio.noveltea",
  "build": {
    "beforeDevCommand": "npm run dev:tauri",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NovelTea",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Office",
    "shortDescription": "A writing tool for long-form fiction",
    "longDescription": "NovelTea keeps a novel in a local database on your own machine. It opens, reads and writes with no network and no account; syncing to a server you run yourself is optional.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzNDA3MzUzODQ1NjM1RDcKUldUWE5WYUVVM05BMDNHZ3d5dnZicXlGejZkemhzTU4xdmZyNW9pQnlZUklUSzZmWGhKYnpCVzUK",
      "endpoints": [
        "https://github.com/ajcarlascio/noveltea/releases/latest/download/latest.json"
      ]
    }
  }
}
